# DSG Stripe App — Azure production environment catalog
#
# Production secret values are stored in Azure Key Vault and resolved through
# Managed Identity. This file contains names/placeholders only; never place live
# credentials in source control.

# Stripe
STRIPE_SECRET_KEY=KEY_VAULT_REFERENCE
STRIPE_WEBHOOK_SECRET=KEY_VAULT_REFERENCE
STRIPE_APP_CLIENT_ID=PUBLIC_OR_NON_SECRET_VALUE
STRIPE_APP_CLIENT_SECRET=KEY_VAULT_REFERENCE

# DSG Control Plane
DSG_API_URL=https://dsg-control-plane.azurewebsites.net
DSG_API_KEY=KEY_VAULT_REFERENCE

# Supabase
SUPABASE_URL=PUBLIC_OR_NON_SECRET_VALUE
SUPABASE_SERVICE_ROLE_KEY=KEY_VAULT_REFERENCE

# Redis / Upstash
UPSTASH_REDIS_REST_URL=PUBLIC_OR_NON_SECRET_VALUE
UPSTASH_REDIS_REST_TOKEN=KEY_VAULT_REFERENCE
REDIS_CACHE_TTL=300

# Runtime
NODE_ENV=production
DSG_ENVIRONMENT=production
LOG_LEVEL=info

# Monitoring
SENTRY_DSN=KEY_VAULT_REFERENCE_OR_EMPTY

# Azure deployment metadata is injected by the deployment workflow.
# DSG_GIT_SHA=<deployed commit sha>
# DSG_IMAGE_DIGEST=<immutable image digest, when applicable>
