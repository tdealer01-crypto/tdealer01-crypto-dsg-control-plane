{
  "schemaVersion": "dsg.azure-ops-secrets.v2",
  "provider": "azure-key-vault",
  "vaultName": "dsg-shared-secrets",
  "resourceGroup": "rg-t.dealer01-0468",
  "description": "Production-authoritative secret and credential values are centralized in Azure Key Vault. Values must never be committed or printed. Existing GitHub Actions workflow permissions are not reduced by this contract; permissions/RBAC remain authorization policy, while secret values live in Key Vault.",
  "authority": {
    "secretValues": "azure-key-vault",
    "runtimeRead": "app-service-system-assigned-managed-identity",
    "ownerOperations": "github-actions-oidc",
    "workflowPermissionPolicy": "preserve-existing-permissions"
  },
  "ownerAccess": {
    "githubActor": "tdealer01-crypto",
    "environment": "prod",
    "entrypoint": ".github/workflows/owner-secret-manager.yml",
    "operations": ["list", "verify", "sync"],
    "secretValueExposure": "never-print-or-export",
    "note": "The owner invokes the console; its Azure OIDC identity receives Key Vault Secrets Officer at vault scope. GitHub Actions/RBAC permissions themselves are not secret values and are not stored in Key Vault."
  },
  "secrets": [
    {
      "environmentName": "MONITORING_API_KEY",
      "keyVaultName": "monitoring-api-key",
      "required": true,
      "scope": "operations",
      "consumer": ".github/workflows/monitoring-daily-health-check.yml",
      "purpose": "Bearer credential for the governed data-sync monitoring endpoint"
    },
    {
      "environmentName": "MONITORING_ORG_ID",
      "keyVaultName": "monitoring-org-id",
      "required": true,
      "scope": "operations",
      "consumer": ".github/workflows/monitoring-daily-health-check.yml",
      "purpose": "Organization scope for the governed data-sync monitoring endpoint"
    },
    {
      "environmentName": "SLACK_WEBHOOK_URL",
      "keyVaultName": "slack-webhook-url",
      "required": false,
      "scope": "operations",
      "consumer": ".github/workflows/monitoring-daily-health-check.yml",
      "purpose": "Optional failure notification webhook"
    },
    {
      "environmentName": "SUPABASE_SERVICE_ROLE_KEY",
      "keyVaultName": "supabase-service-role-key",
      "required": true,
      "scope": "runtime-core",
      "consumer": "config/azure-runtime-env.contract.json",
      "purpose": "Server-side Supabase service credential"
    },
    {
      "environmentName": "NEXTAUTH_SECRET",
      "keyVaultName": "nextauth-secret",
      "required": true,
      "scope": "runtime-core",
      "consumer": "config/azure-runtime-env.contract.json",
      "purpose": "Authentication session signing secret"
    },
    {
      "environmentName": "UPSTASH_REDIS_REST_TOKEN",
      "keyVaultName": "upstash-redis-rest-token",
      "required": true,
      "scope": "runtime-core",
      "consumer": "config/azure-runtime-env.contract.json",
      "purpose": "Upstash Redis REST authentication token"
    },
    {
      "environmentName": "DSG_PROMOTION_EVALUATION_SECRET",
      "keyVaultName": "dsg-promotion-evaluation-secret",
      "required": true,
      "scope": "runtime-governed",
      "consumer": "config/azure-runtime-env.contract.json",
      "purpose": "Governed promotion evaluation authentication"
    },
    {
      "environmentName": "DSG_POST_DEPLOY_FEEDBACK_SECRET",
      "keyVaultName": "dsg-post-deploy-feedback-secret",
      "required": true,
      "scope": "runtime-governed",
      "consumer": "config/azure-runtime-env.contract.json",
      "purpose": "Post-deployment feedback authentication"
    },
    {
      "environmentName": "DSG_PRODUCTION_ROLLBACK_SECRET",
      "keyVaultName": "dsg-production-rollback-secret",
      "required": true,
      "scope": "runtime-governed",
      "consumer": "config/azure-runtime-env.contract.json",
      "purpose": "Production rollback authorization secret"
    },
    {
      "environmentName": "DSG_GITHUB_AUTOMATION_TOKEN",
      "keyVaultName": "dsg-github-automation-token",
      "required": true,
      "scope": "runtime-governed",
      "consumer": "config/azure-runtime-env.contract.json",
      "purpose": "GitHub cross-repository automation credential"
    },
    {
      "environmentName": "AZURE_CLIENT_SECRET",
      "keyVaultName": "azure-client-secret",
      "required": true,
      "scope": "runtime-rollback",
      "consumer": "config/azure-runtime-env.contract.json",
      "purpose": "Legacy rollback adapter service-principal credential; OIDC remains preferred for CI"
    }
  ]
}
