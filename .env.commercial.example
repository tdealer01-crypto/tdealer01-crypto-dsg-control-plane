# DSG ONE commercial deployment template
# Copy into Railway Variables or another secret manager. Never commit real values.

NODE_ENV=production
PORT=8080
NEXT_PUBLIC_APP_URL=https://YOUR_COMMERCIAL_DOMAIN
APP_URL=https://YOUR_COMMERCIAL_DOMAIN
NEXT_PUBLIC_SITE_URL=https://YOUR_COMMERCIAL_DOMAIN

# Supabase control plane
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Existing DSG control-plane connection
DSG_CORE_MODE=control-plane
DSG_CONTROL_PLANE_BASE_URL=https://tdealer01-crypto-dsg-control-plane-nine.vercel.app
DSG_ONE_V1_BASE_URL=https://tdealer01-crypto-dsg-control-plane-nine.vercel.app
DSG_ALLOWED_ORIGINS=https://YOUR_COMMERCIAL_DOMAIN
READINESS_STRICT=true

# Billing: use live keys only after Stripe business verification and webhook setup
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PRO_YEARLY=price_REPLACE_ME
STRIPE_PRICE_BUSINESS_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_BUSINESS_YEARLY=price_REPLACE_ME
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ENTERPRISE_YEARLY=price_REPLACE_ME
STRIPE_PRICE_PRO_OVERAGE=price_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# MCP/API access and server-to-server protection
DSG_API_KEY=REPLACE_WITH_SERVER_OR_WORKSPACE_KEY
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
DSG_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_SECRET
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET

# Optional metering/telemetry
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
